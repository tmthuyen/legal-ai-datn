# Cấu hình Services (Golang) — copy sang .env và điền giá trị thật.
# Tham chiếu: docs/contracts/API_CONTRACT.md §6

# Cổng chạy Services (Gin)
APP_PORT=8080

# debug | release
GIN_MODE=debug

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=legalai
DB_PASSWORD=legalai
DB_NAME=legalai
DB_SSLMODE=disable

# JWT — JWT_SECRET bắt buộc >= 32 ký tự, không được commit giá trị thật
JWT_SECRET=change-me-to-a-random-secret-at-least-32-chars
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_HOURS=168

# CORS — danh sách origin của Frontend, phân tách bằng dấu phẩy
CORS_ALLOWED_ORIGINS=http://localhost:3002

# Backend FastAPI (AI Worker)
AI_BACKEND_URL=http://localhost:8090
AI_BACKEND_TIMEOUT_SECONDS=60

# Refresh token cookie Secure flag — false khi dev (http), true khi production (https)
COOKIE_SECURE=false
